[Unit]
Description=Movimente-se — coleta o grupo, processa e publica o ranking
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=USUARIO
WorkingDirectory=/home/USUARIO/movimente-automacao
ExecStart=/home/USUARIO/movimente-automacao/scripts/executar.sh
# A pipeline ja tem trava propria; este teto evita ficar presa para sempre.
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
